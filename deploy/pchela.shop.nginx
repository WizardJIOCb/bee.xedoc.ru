server {
    server_name pchela.shop www.pchela.shop;

    client_max_body_size 64m;

    location / {
        proxy_pass http://127.0.0.1:3031;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 75s;
    }

    location = /health {
        proxy_pass http://127.0.0.1:3031/health;
        proxy_set_header Host $host;
        access_log off;
    }

    access_log /var/log/nginx/pchela.shop.access.log;
    error_log /var/log/nginx/pchela.shop.error.log;

    listen 443 ssl;
    listen [::]:443 ssl;
    ssl_certificate /etc/letsencrypt/live/pchela.shop/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/pchela.shop/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
}

server {
    listen 80;
    listen [::]:80;
    server_name pchela.shop www.pchela.shop;
    return 301 https://$host$request_uri;
}
