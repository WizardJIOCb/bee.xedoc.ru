<%- include('partials/head', { title, bodyClass: 'dashboard-page' }) %>
<%- include('partials/header') %>
<main>
  <section class="dashboard-hero">
    <div class="container dashboard-hero-row"><div><span class="section-kicker">Кабинет поставщика</span><h1><%= apiary.name %></h1><p><%= apiary.published ? 'Карточка опубликована и видна закупщикам.' : 'Заполните карточку, добавьте партию и опубликуйте её.' %></p></div><div class="publish-status <%= apiary.published ? 'online' : '' %>"><span></span><%= apiary.published ? 'в каталоге' : 'черновик' %></div></div>
  </section>
  <section class="container dashboard-layout">
    <nav class="dashboard-nav"><a href="#profile">Профиль пасеки</a><a href="#lots">Партии <b><%= lots.length %></b></a><a href="#inquiries">Заявки <b><%= inquiries.filter(i => i.status === 'new').length %></b></a><a href="/dashboard/publications">Мои публикации</a><a href="#account">Аккаунт</a><% if (apiary.published) { %><a href="/suppliers/<%= apiary.slug %>">Открыть страницу ↗</a><% } %></nav>
    <div class="dashboard-content">
      <section class="dashboard-card" id="profile">
        <div class="dashboard-card-heading"><div><span class="section-kicker">Основа доверия</span><h2>Профиль пасеки</h2></div><span class="completion"><%= apiary.story && apiary.hives_count ? 'заполнено' : 'нужно дополнить' %></span></div>
        <form method="post" action="/dashboard/profile" class="profile-form">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="filter-two"><label class="field"><span>Название</span><input name="name" value="<%= apiary.name %>" required></label><label class="field"><span>Тип хозяйства</span><select name="production_type"><% ['Семейная пасека','Семейная кочевая пасека','Стационарная лесная пасека','Фермерское хозяйство','Производство и фасовка'].forEach(value => { %><option value="<%= value %>" <%= apiary.production_type === value ? 'selected' : '' %>><%= value %></option><% }) %></select></label></div>
          <label class="field"><span>О хозяйстве</span><textarea name="story" rows="5" maxlength="1800" placeholder="Где стоят ульи, как работаете с партиями, чем отличаетесь"><%= apiary.story %></textarea></label>
          <label class="field"><span>Обложка профиля</span><select name="cover_image"><% coverChoices.forEach(choice => { %><option value="<%= choice.value %>" <%= apiary.cover_image === choice.value ? 'selected' : '' %>><%= choice.label %></option><% }) %></select><small>На старте можно выбрать одну из фирменных фотографий. Загрузка собственной фотографии появится следующим этапом.</small></label>
          <div class="form-grid-three"><label class="field"><span>Ближайший город</span><select name="city_code" required><% cities.forEach(city => { %><option value="<%= city.code %>" <%= apiary.city_code === city.code ? 'selected' : '' %>><%= city.name %></option><% }) %></select></label><label class="field"><span>Точная локация без адреса</span><input name="location_detail" value="<%= apiary.location_detail %>" placeholder="Ишимбайский район"></label><label class="field"><span>Лет опыта</span><input type="number" name="years_experience" min="0" max="100" value="<%= apiary.years_experience %>"></label></div>
          <div class="form-grid-three"><label class="field"><span>Количество пчелосемей</span><input type="number" name="hives_count" min="0" value="<%= apiary.hives_count %>"></label><label class="field span-two"><span>Условия доставки</span><input name="delivery" value="<%= apiary.delivery %>" placeholder="Самовывоз, доставка от 300 кг"></label></div>
          <label class="field"><span>Документы и подтверждения</span><input name="certifications" value="<%= apiary.certifications %>" placeholder="Паспорт пасеки, лабораторный протокол"></label>
          <div class="checks-row"><label class="check-field"><input type="checkbox" name="lab_verified" value="1" <%= apiary.lab_verified ? 'checked' : '' %>><span class="fake-check">✓</span><span>Есть лабораторный анализ</span></label><label class="check-field"><input type="checkbox" name="frame_available" value="1" <%= apiary.frame_available ? 'checked' : '' %>><span class="fake-check">✓</span><span>Можно поставить запечатанные рамки</span></label></div>
          <div class="publish-row"><label class="switch-field"><input type="checkbox" name="published" value="1" <%= apiary.published ? 'checked' : '' %>><span class="switch"></span><span><b>Опубликовать карточку</b><small>Она станет доступна в общем каталоге</small></span></label><button class="button button-dark" type="submit">Сохранить профиль</button></div>
        </form>
      </section>

      <section class="dashboard-card" id="lots">
        <div class="dashboard-card-heading"><div><span class="section-kicker">Урожай и условия</span><h2>Партии</h2></div><button class="button button-primary" type="button" data-dialog-open="lot-dialog">+ Добавить партию</button></div>
        <% if (lots.length) { %><div class="dashboard-lots"><% lots.forEach(lot => { %><article class="dashboard-lot <%= lot.available ? '' : 'muted' %>"><div><span class="lot-form"><%= lot.form %></span><h3><%= lot.variety %></h3><p><%= lot.harvest_year %> · <%= lot.packaging || 'тара обсуждается' %></p></div><div><small>Остаток</small><strong><%= number(lot.stock_kg) %> кг</strong></div><div><small>Цена</small><strong><%= money(lot.price_per_kg) %>/кг</strong></div><div class="lot-actions"><form method="post" action="/dashboard/lots/<%= lot.id %>/toggle"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button type="submit" class="icon-button" title="Изменить доступность"><%= lot.available ? '◉' : '○' %></button></form><form method="post" action="/dashboard/lots/<%= lot.id %>/delete" data-confirm="Удалить эту партию?"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button type="submit" class="icon-button danger" title="Удалить">×</button></form></div></article><% }) %></div><% } else { %><div class="empty-inline"><span>⬡</span><div><h3>Пока нет партий</h3><p>Добавьте сорт, объём и цену — закупщики увидят предложение в каталоге.</p></div></div><% } %>
      </section>

      <section class="dashboard-card" id="inquiries">
        <div class="dashboard-card-heading"><div><span class="section-kicker">Прямые обращения</span><h2>Заявки закупщиков</h2></div><span><%= inquiries.length %> всего</span></div>
        <% if (inquiries.length) { %><div class="inquiry-list"><% inquiries.forEach(inquiry => { %><article class="inquiry"><div class="inquiry-person"><span class="avatar"><%= inquiry.display_name.slice(0,1) %></span><div><h3><%= inquiry.company_name || inquiry.display_name %></h3><p><%= inquiry.email %> · <%= new Date(inquiry.created_at + 'Z').toLocaleDateString('ru-RU') %></p></div></div><div class="inquiry-need"><small>Нужно</small><strong><%= number(inquiry.volume_kg) %> кг · <%= inquiry.variety || 'сорт обсуждается' %></strong><p>Доставка: <%= inquiry.delivery_city %></p></div><p class="inquiry-message"><%= inquiry.message || 'Без дополнительного комментария.' %></p><form method="post" action="/inquiries/<%= inquiry.id %>/status"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><select name="status" data-auto-submit><option value="new" <%= inquiry.status === 'new' ? 'selected' : '' %>>Новая</option><option value="contacted" <%= inquiry.status === 'contacted' ? 'selected' : '' %>>Связались</option><option value="agreed" <%= inquiry.status === 'agreed' ? 'selected' : '' %>>Договорились</option><option value="closed" <%= inquiry.status === 'closed' ? 'selected' : '' %>>Закрыта</option></select></form></article><% }) %></div><% } else { %><div class="empty-inline"><span>↗</span><div><h3>Заявки появятся здесь</h3><p>Чем подробнее профиль и партии, тем проще магазину принять решение.</p></div></div><% } %>
      </section>
      <section class="dashboard-card publication-dashboard-cta"><div><span class="section-kicker">Говорите от своего имени</span><h2>Новости и статьи пасеки</h2><p>Анонсируйте ярмарку, отметьте участников события или поделитесь опытом хозяйства.</p></div><div><a class="button button-primary" href="/dashboard/publications/new">+ Создать материал</a><a class="text-link" href="/dashboard/publications">Все мои публикации →</a></div></section>
      <%- include('partials/account-settings') %>
    </div>
  </section>

  <dialog class="modal" id="lot-dialog">
    <form method="post" action="/dashboard/lots" class="modal-card">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="modal-close" type="button" data-dialog-close aria-label="Закрыть">×</button><span class="section-kicker">Новое предложение</span><h2>Добавить партию</h2>
      <div class="filter-two"><label class="field"><span>Сорт / медонос</span><input name="variety" required placeholder="Башкирская липа"></label><label class="field"><span>Формат</span><select name="form"><option>Мёд в таре</option><option>Запечатанная рамка</option><option>Фасованный продукт</option></select></label></div>
      <div class="form-grid-three"><label class="field"><span>Урожай</span><input type="number" name="harvest_year" min="2020" max="2035" value="<%= year %>"></label><label class="field"><span>Объём, кг</span><input type="number" name="stock_kg" min="1" required placeholder="500"></label><label class="field"><span>Мин. заказ, кг</span><input type="number" name="min_order_kg" min="1" required placeholder="50"></label></div>
      <label class="field"><span>Цена, ₽ за кг</span><input type="number" name="price_per_kg" min="1" step="0.01" required placeholder="650"></label><label class="field"><span>Тара</span><input name="packaging" placeholder="Куботейнер 23 кг"></label><label class="field"><span>О партии</span><textarea name="quality_note" rows="3" placeholder="Дата качки, влажность, особенности"></textarea></label>
      <button class="button button-primary button-block" type="submit">Добавить партию</button>
    </form>
  </dialog>
</main>
<%- include('partials/footer') %>
