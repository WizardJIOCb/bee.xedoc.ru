<%- include('partials/head', { title, bodyClass: 'dashboard-page buyer-dashboard' }) %>
<%- include('partials/header') %>
<main>
  <section class="dashboard-hero buyer-hero"><div class="container dashboard-hero-row"><div><span class="section-kicker">Кабинет закупщика</span><h1><%= currentUser.company_name || currentUser.display_name %></h1><p>Сохранённые хозяйства и все запросы на поставку.</p></div><a class="button button-primary" href="/catalog?from=<%= currentUser.city_code %>">Найти поставщика</a></div></section>
  <section class="container buyer-dashboard-grid">
    <div class="dashboard-card">
      <div class="dashboard-card-heading"><div><span class="section-kicker">В работе</span><h2>Мои заявки</h2></div><span><%= inquiries.length %> всего</span></div>
      <% if (inquiries.length) { %><div class="buyer-inquiries"><% inquiries.forEach(inquiry => { %><article><div><span class="status-pill status-<%= inquiry.status %>"><%= ({new:'отправлена',contacted:'на связи',agreed:'договорились',closed:'закрыта'})[inquiry.status] %></span><h3><a href="/suppliers/<%= inquiry.slug %>"><%= inquiry.apiary_name %></a></h3><p><%= inquiry.variety || 'Подходящая партия' %> · <%= number(inquiry.volume_kg) %> кг</p></div><div><small>Доставка</small><strong><%= inquiry.delivery_city %></strong><p><%= new Date(inquiry.created_at + 'Z').toLocaleDateString('ru-RU') %></p></div><a class="card-link" href="/suppliers/<%= inquiry.slug %>">Открыть →</a></article><% }) %></div><% } else { %><div class="empty-inline"><span>↗</span><div><h3>Вы ещё не отправляли заявок</h3><p>Откройте пасеку в каталоге и укажите нужный объём.</p><a class="text-link" href="/catalog">Перейти в каталог →</a></div></div><% } %>
    </div>
    <div class="dashboard-card">
      <div class="dashboard-card-heading"><div><span class="section-kicker">На заметку</span><h2>Избранные пасеки</h2></div><span><%= favorites.length %></span></div>
      <% if (favorites.length) { %><div class="favorite-list"><% favorites.forEach(apiary => { const city = cityMap.get(apiary.city_code); %><a href="/suppliers/<%= apiary.slug %>"><span class="favorite-mark accent-<%= apiary.accent %>">⬡</span><div><h3><%= apiary.name %></h3><p><%= city?.name || '' %> · <%= number(apiary.stock_kg || 0) %> кг в наличии</p></div><strong><%= apiary.min_price ? money(apiary.min_price) + '/кг' : 'по запросу' %></strong><span>→</span></a><% }) %></div><% } else { %><div class="empty-inline"><span>☆</span><div><h3>Сохраняйте интересные хозяйства</h3><p>Кнопка «В избранное» есть на каждой странице пасеки.</p></div></div><% } %>
    </div>
    <%- include('partials/account-settings') %>
  </section>
</main>
<%- include('partials/footer') %>
