<%- include('partials/head', { title, bodyClass: 'admin-page dashboard-page' }) %>
<%- include('partials/header') %>
<main>
  <section class="admin-hero admin-edit-hero"><div class="container"><a class="admin-back" href="/admin">← Пульс платформы</a><div class="admin-hero-row"><div><span class="section-kicker">Редакция pchela.shop</span><h1>Публикации</h1><p>Новости, события и авторские статьи участников — с единой модерацией.</p></div><a class="button button-primary" href="/admin/publications/new">+ Создать материал</a></div></div></section>
  <section class="container admin-publications-layout">
    <div class="admin-stats publication-admin-stats">
      <article class="admin-stat admin-stat-primary"><span>Всего материалов</span><strong><%= number(stats.total || 0) %></strong><p>черновики, очередь и опубликованные</p></article>
      <article><span>Ждут проверки</span><strong><%= number(stats.pending || 0) %></strong><p>авторы ожидают решения</p></article>
      <article><span>Опубликовано</span><strong><%= number(stats.published || 0) %></strong><p>доступны всем посетителям</p></article>
      <article><span>Скоро состоятся</span><strong><%= number(stats.upcoming || 0) %></strong><p>предстоящие события</p></article>
    </div>
    <section class="dashboard-card">
      <div class="dashboard-card-heading"><div><span class="section-kicker">Редакционная очередь</span><h2>Все материалы</h2></div><span><%= items.length %> показано</span></div>
      <form class="admin-filter publication-admin-filter" method="get" action="/admin/publications">
        <label class="field"><span class="sr-only">Поиск</span><input name="q" value="<%= filters.q %>" placeholder="Заголовок, автор или компания"></label>
        <label class="field"><span class="sr-only">Тип</span><select name="kind"><option value="">Все типы</option><option value="news" <%= filters.kind === 'news' ? 'selected' : '' %>>Новости</option><option value="event" <%= filters.kind === 'event' ? 'selected' : '' %>>События</option><option value="article" <%= filters.kind === 'article' ? 'selected' : '' %>>Статьи</option></select></label>
        <label class="field"><span class="sr-only">Статус</span><select name="status"><option value="">Все статусы</option><option value="pending" <%= filters.status === 'pending' ? 'selected' : '' %>>На модерации</option><option value="published" <%= filters.status === 'published' ? 'selected' : '' %>>Опубликовано</option><option value="draft" <%= filters.status === 'draft' ? 'selected' : '' %>>Черновики</option><option value="rejected" <%= filters.status === 'rejected' ? 'selected' : '' %>>Нужны изменения</option></select></label>
        <button class="button button-dark" type="submit">Показать</button><a class="button button-outline-dark" href="/admin/publications">Сбросить</a>
      </form>
      <% if (items.length) { %><div class="publication-admin-list"><% items.forEach(item => { %><article class="publication-admin-item publication-admin-item-<%= item.status %>"><div class="publication-manager-thumb"><% if (item.cover_url) { %><img src="<%= item.cover_url %>" alt=""><% } else { %><span><%= item.kind === 'event' ? '◷' : item.kind === 'news' ? '↗' : '¶' %></span><% } %></div><div class="publication-admin-copy"><div class="badges"><span class="publication-kind"><%= ({news:'Новость',event:'Событие',article:'Статья'})[item.kind] %></span><span class="status-pill publication-status-<%= item.status %>"><%= ({draft:'черновик',pending:'на модерации',published:'опубликовано',rejected:'нужны изменения'})[item.status] %></span></div><h3><a href="/publications/<%= item.slug %>"><%= item.title %></a></h3><p><b><%= item.author_company || item.author_name %></b> · <%= new Date(item.updated_at + 'Z').toLocaleString('ru-RU') %> · <%= item.attachments_count %> влож.</p><% if (item.kind === 'event' && item.event_starts_at) { %><small>◷ <%= new Date(item.event_starts_at).toLocaleString('ru-RU') %><%= item.event_location ? ` · ${item.event_location}` : '' %></small><% } %></div><form class="publication-moderation" method="post" action="/admin/publications/<%= item.id %>/status"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><select name="status"><option value="published" <%= item.status === 'published' ? 'selected' : '' %>>Опубликовано</option><option value="pending" <%= item.status === 'pending' ? 'selected' : '' %>>На модерации</option><option value="draft" <%= item.status === 'draft' ? 'selected' : '' %>>Черновик</option><option value="rejected" <%= item.status === 'rejected' ? 'selected' : '' %>>Нужны изменения</option></select><input name="moderation_note" maxlength="500" value="<%= item.moderation_note %>" placeholder="Комментарий автору"><div><a class="mini-action" href="/admin/publications/<%= item.id %>/edit">Редактировать</a><button class="mini-action positive" type="submit">Применить</button></div></form></article><% }) %></div><% } else { %><div class="publication-empty compact"><span>✓</span><h2>Очередь пуста</h2><p>По выбранным фильтрам материалов нет.</p></div><% } %>
    </section>
  </section>
</main>
<%- include('partials/footer') %>
